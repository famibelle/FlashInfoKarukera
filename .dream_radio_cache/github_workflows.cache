le", "html_url": "https://github.com/famibelle", "followers_url": "https://api.github.com/users/famibelle/followers", "following_url": "https://api.github.com/users/famibelle/following{/other_user}", "gists_url": "https://api.github.com/users/famibelle/gists{/gist_id}", "starred_url": "https://api.github.com/users/famibelle/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/famibelle/subscriptions", "organizations_url": "https://api.github.com/users/famibelle/orgs", "repos_url": "https://api.github.com/users/famibelle/repos", "events_url": "https://api.github.com/users/famibelle/events{/privacy}", "received_events_url": "https://api.github.com/users/famibelle/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "jobs_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/runs/25539500918/jobs", "logs_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/runs/25539500918/logs", "check_suite_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/check-suites/68032109663", "artifacts_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/runs/25539500918/artifacts", "cancel_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/runs/25539500918/cancel", "rerun_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/runs/25539500918/rerun", "previous_attempt_url": null, "workflow_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/workflows/271311366", "head_commit": {"id": "336b55191505771c19083a456653aa06ccad4e47", "tree_id": "fe192b7e1656379a94a813e21d27c27bb64dd5da", "message": "fix: corriger décalage horaire dans flash-info-gwada.py\n\nProblème : Le script utilisait datetime.now(GUADELOUPE_TZ).date() pour\nlire la date, ce qui donne la date locale de la Guadeloupe (UTC-4).\nÀ 03h UTC le 8 mai, il est 23h le 7 mai en Guadeloupe → le script\ngénérait les fichiers du 7 mai au lieu du 8 mai.\n\nSolution : Utiliser datetime.now(timezone.utc).date() pour correspondre\naux workflows GitHub Actions qui s'exécutent en UTC.\n\nModifications :\n- Ajout now_utc = datetime.now(timezone.utc)\n- target_date = now_utc.date() au lieu de now_gwada.date()\n- Ajout affichage de l'heure UTC pour debug\n\nGenerated by Mistral Vibe.\nCo-Authored-By: Mistral Vibe <vibe@mistral.ai>", "timestamp": "2026-05-08T05:49:15Z", "author": {"name": "famibelle", "email": "medhi.famibelle@gmail.com"}, "committer": {"name": "famibelle", "email": "medhi.famibelle@gmail.com"}}, "repository": {"id": 1216233862, "node_id": "R_kgDOSH5Bhg", "name": "FlashInfoKarukera", "full_name": "famibelle/FlashInfoKarukera", "private": false, "owner": {"login": "famibelle", "id": 5863796, "node_id": "MDQ6VXNlcjU4NjM3OTY=", "avatar_url": "https://avatars.githubusercontent.com/u/5863796?v=4", "gravatar_id": "", "url": "https://api.github.com/users/famibelle", "html_url": "https://github.com/famibelle", "followers_url": "https://api.github.com/users/famibelle/followers", "following_url": "https://api.github.com/users/famibelle/following{/other_user}", "gists_url": "https://api.github.com/users/famibelle/gists{/gist_id}", "starred_url": "https://api.github.com/users/famibelle/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/famibelle/subscriptions", "organizations_url": "https://api.github.com/users/famibelle/orgs", "repos_url": "https://api.github.com/users/famibelle/repos", "events_url": "https://api.github.com/users/famibelle/events{/privacy}", "received_events_url": "https://api.github.com/users/famibelle/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "html_url": "https://github.com/famibelle/FlashInfoKarukera", "description": null, "fork": false, "url": "https://api.github.com/repos/famibelle/FlashInfoKarukera", "forks_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/forks", "keys_url": "https://api.github.com/repos/famibelle/FlashInfoK