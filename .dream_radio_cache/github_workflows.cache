, "workflow_id": 271311366, "check_suite_id": 68157385925, "check_suite_node_id": "CS_kwDOSH5Bhs8AAAAP3n8sxQ", "url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/runs/25580891289", "html_url": "https://github.com/famibelle/FlashInfoKarukera/actions/runs/25580891289", "pull_requests": [], "created_at": "2026-05-08T21:40:19Z", "updated_at": "2026-05-08T22:20:09Z", "actor": {"login": "famibelle", "id": 5863796, "node_id": "MDQ6VXNlcjU4NjM3OTY=", "avatar_url": "https://avatars.githubusercontent.com/u/5863796?v=4", "gravatar_id": "", "url": "https://api.github.com/users/famibelle", "html_url": "https://github.com/famibelle", "followers_url": "https://api.github.com/users/famibelle/followers", "following_url": "https://api.github.com/users/famibelle/following{/other_user}", "gists_url": "https://api.github.com/users/famibelle/gists{/gist_id}", "starred_url": "https://api.github.com/users/famibelle/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/famibelle/subscriptions", "organizations_url": "https://api.github.com/users/famibelle/orgs", "repos_url": "https://api.github.com/users/famibelle/repos", "events_url": "https://api.github.com/users/famibelle/events{/privacy}", "received_events_url": "https://api.github.com/users/famibelle/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "run_attempt": 1, "referenced_workflows": [], "run_started_at": "2026-05-08T21:40:19Z", "triggering_actor": {"login": "famibelle", "id": 5863796, "node_id": "MDQ6VXNlcjU4NjM3OTY=", "avatar_url": "https://avatars.githubusercontent.com/u/5863796?v=4", "gravatar_id": "", "url": "https://api.github.com/users/famibelle", "html_url": "https://github.com/famibelle", "followers_url": "https://api.github.com/users/famibelle/followers", "following_url": "https://api.github.com/users/famibelle/following{/other_user}", "gists_url": "https://api.github.com/users/famibelle/gists{/gist_id}", "starred_url": "https://api.github.com/users/famibelle/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/famibelle/subscriptions", "organizations_url": "https://api.github.com/users/famibelle/orgs", "repos_url": "https://api.github.com/users/famibelle/repos", "events_url": "https://api.github.com/users/famibelle/events{/privacy}", "received_events_url": "https://api.github.com/users/famibelle/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "jobs_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/runs/25580891289/jobs", "logs_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/runs/25580891289/logs", "check_suite_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/check-suites/68157385925", "artifacts_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/runs/25580891289/artifacts", "cancel_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/runs/25580891289/cancel", "rerun_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/runs/25580891289/rerun", "previous_attempt_url": null, "workflow_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/actions/workflows/271311366", "head_commit": {"id": "3b3ba4309c8ec4517f8713a29171e4c6f35a8f92", "tree_id": "124545631740484cf7180d2d2a3a3d28bd9de681", "message": "fix: corriger conflits git modify/delete dans les workflows de génération\n\nRemplace le pattern \"commit → stash → rebase → push\" par \"pull → commit → push+retry\"\ndans les 4 workflows (capsules, flash-info, horoscope, émission).\n\nL'ancienne stratégie échouait avec CONFLICT (modify/delete) quand deux runs\nse chevauchaient sur la même journée : le rebase -X theirs ne résout pas les\nconflits de type modify/delete sur les fichiers audio/JSON générés.\n\nNouvelle stratégie :\n  1. git pull --no-rebase -X ours  (on est déjà à jour avant de stager)\n  2. git add + git commit\n  3. git push || (pull --rebase -X ours + push)  (