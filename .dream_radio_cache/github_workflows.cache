 horoscope, flash-info, capsules, emission, playlist.\n\nGenerated by Mistral Vibe.\nCo-Authored-By: Mistral Vibe <vibe@mistral.ai>", "timestamp": "2026-05-06T11:27:21Z", "author": {"name": "famibelle", "email": "medhi.famibelle@gmail.com"}, "committer": {"name": "famibelle", "email": "medhi.famibelle@gmail.com"}}, "repository": {"id": 1216233862, "node_id": "R_kgDOSH5Bhg", "name": "FlashInfoKarukera", "full_name": "famibelle/FlashInfoKarukera", "private": false, "owner": {"login": "famibelle", "id": 5863796, "node_id": "MDQ6VXNlcjU4NjM3OTY=", "avatar_url": "https://avatars.githubusercontent.com/u/5863796?v=4", "gravatar_id": "", "url": "https://api.github.com/users/famibelle", "html_url": "https://github.com/famibelle", "followers_url": "https://api.github.com/users/famibelle/followers", "following_url": "https://api.github.com/users/famibelle/following{/other_user}", "gists_url": "https://api.github.com/users/famibelle/gists{/gist_id}", "starred_url": "https://api.github.com/users/famibelle/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/famibelle/subscriptions", "organizations_url": "https://api.github.com/users/famibelle/orgs", "repos_url": "https://api.github.com/users/famibelle/repos", "events_url": "https://api.github.com/users/famibelle/events{/privacy}", "received_events_url": "https://api.github.com/users/famibelle/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "html_url": "https://github.com/famibelle/FlashInfoKarukera", "description": null, "fork": false, "url": "https://api.github.com/repos/famibelle/FlashInfoKarukera", "forks_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/forks", "keys_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/keys{/key_id}", "collaborators_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/collaborators{/collaborator}", "teams_url": "https://api.github.com/repos/famibelle/FlashInfoKarukera/teams", "hooks_url": "https://